{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Smart Parking Server (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/backend/build/smart_parking_server.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/backend",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "preLaunchTask": "Build Smart Parking Backend",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}

